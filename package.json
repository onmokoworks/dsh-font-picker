{
  "name": "dsh-font-picker",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "description": "Windows font picker for DeepSeek Harness",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/onmokoworks/dsh-font-picker.git"
  },
  "homepage": "https://github.com/onmokoworks/dsh-font-picker",
  "bugs": {
    "url": "https://github.com/onmokoworks/dsh-font-picker/issues"
  },
  "scripts": {
    "test": "node --test verification/*.test.mjs"
  }
}
